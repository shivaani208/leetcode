class Solution {
    public int numberOfSteps(int num) {
        int count_step=0;
        while(num>0) {
            if(num%2==0) {
                num=num/2;
                count_step=count_step+1;

            }
            else{
                num=num-1;
                count_step=count_step+1;

            }
        }
        return count_step;
        
    }
}
