class Solution {
    public boolean isPalindrome(int x) {
        if(x<0) {
            return false;

        }
        int rev=0,temp, check=x;
        while(x>0) {
            temp=x%10;
            rev=(rev*10)+temp;
            x=x/10;

        }
        if(check==rev) {
            return true;

        }
        else{
            return false;
        }
        
    }
}
